<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="4dp"
    app:cardElevation="4dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/image_wanderweg"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="center" />

        <TextView
            android:id="@+id/text_guide_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/name_of_the_guide"
            android:textSize="18sp"
            android:layout_marginTop="8dp"/>



        <TextView
            android:id="@+id/distance_in_km"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="X km"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/text_start_finish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A: Start, B: Finish"/>

        <TextView
            android:id="@+id/text_sightseeing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sightseeing 1, Sightseeing 2..."/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/ratingButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|right"
            android:layout_marginBottom="70dp"
            android:layout_marginRight="10dp"
            app:backgroundTint="@color/primaryColor"/>
        <TextView
            android:id="@+id/ratingButton_text"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="@string/_0_0"
            android:layout_gravity="bottom|right"
            android:layout_marginBottom="78dp"
            android:layout_marginRight="15dp"
            android:elevation="6dp"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:fontFamily="@font/libre_baskerville" />

        </FrameLayout>

</androidx.cardview.widget.CardView>
